---
import { Icon } from 'astro-icon/components'
---

<button
  id="theme-toggle"
  type="button"
  class="fixed z-40 flex size-8 items-center justify-center rounded-full border border-line bg-surface text-muted shadow-soft transition-all duration-300 hover:border-accent hover:text-accent hover:shadow-md active:scale-95"
  style={{
    insetInlineEnd: 'var(--back-to-top-offset)',
    bottom: 'calc(var(--back-to-top-offset) + var(--back-to-top-size) + 0.5rem)',
  }}
  aria-label="Toggle theme"
>
  <Icon name="tabler:sun" class="size-4 theme-icon theme-icon-sun" />
  <Icon name="tabler:moon" class="size-4 theme-icon theme-icon-moon" />
</button>

<style>
  .theme-icon-moon {
    display: none;
  }

  :global(.dark) .theme-icon-sun {
    display: none;
  }

  :global(.dark) .theme-icon-moon {
    display: block;
  }
</style>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const html = document.documentElement
    html.classList.toggle('dark')
    const theme = html.classList.contains('dark') ? 'dark' : 'light'
    html.classList.toggle('light', theme === 'light')
    localStorage.setItem('theme', theme)
    document.cookie = `theme=${theme}; path=/; max-age=31536000; samesite=lax`
    html.style.backgroundColor = theme === 'dark' ? '#1c1a18' : '#f4f1ec'
    const metaTheme = document.querySelector('meta[name="theme-color"]')
    if (metaTheme) {
      metaTheme.setAttribute('content', theme === 'dark' ? '#1c1a18' : '#f4f1ec')
    }
  })
</script>
